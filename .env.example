# ==============================================================================
# ARGUS Environment Configuration Template
# Copy this file to .env and provide your private API keys.
# ==============================================================================

# App Environment & Logging
ARGUS_ENV=development
ARGUS_LOG_LEVEL=INFO

# ==============================================================================
# Sponsor Gateway: Maxim AI Bifrost (Self-Hosted Open-Source AI Gateway)
# GitHub: https://github.com/maximhq/bifrost
# ==============================================================================
# Setup token for first-time dashboard unlocked at http://localhost:8080
BIFROST_SETUP_TOKEN=argus-admin-token-2026

# When running Bifrost locally or in Docker (default port: 8080):
# - Local dev:    http://localhost:8080/v1
# - Docker stack: http://bifrost:8080/v1
ARGUS_BIFROST_BASE_URL=http://localhost:8080/v1
# Virtual Key or Basic Auth: use 'sk-bf-local' OR provide admin credentials for HTTP Basic auth
ARGUS_BIFROST_API_KEY=sk-bf-local
# Optional: HTTP Basic auth admin credentials (auto-base64 encoded as Authorization: Basic <base64(user:pass)>)
BIFROST_ADMIN_USERNAME=
BIFROST_ADMIN_PASSWORD=
ARGUS_BIFROST_PRIMARY_MODEL=claude-3-5-sonnet-20241022
ARGUS_BIFROST_FALLBACK_MODEL=gpt-4o

# Bring-Your-Own LLM Provider Keys (forwarded to self-hosted Bifrost gateway)
# Bifrost unifies these upstream providers behind its OpenAI-compatible endpoint:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Optional additional providers supported by Bifrost:
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Sponsor Integration: Tavily Search (OSINT Threat Intelligence)
ARGUS_TAVILY_API_KEY=your_tavily_search_api_key_here

# Persistence & Storage
ARGUS_DATABASE_URL=sqlite+aiosqlite:///argus.db
ARGUS_DB_PATH=./argus.db
ARGUS_ARTIFACTS_DIR=./artifacts

# API
ARGUS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Execution Limits
ARGUS_DEFAULT_MAX_DURATION_SECONDS=1800
ARGUS_DEFAULT_MAX_ITERATIONS=20
ARGUS_DEFAULT_MAX_MODEL_CALLS=40
ARGUS_DEFAULT_TOOL_TIMEOUT_SECONDS=120
ARGUS_MAX_CONSECUTIVE_FAILURES=3

# Feature Flags
ARGUS_SIMULATION_MODE=false
ARGUS_ENABLE_TAVILY_RESEARCH=true
ARGUS_ENABLE_PROVIDER_FALLBACK=true
ARGUS_STRICT_SCOPE_ENFORCEMENT=true

